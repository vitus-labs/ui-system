{
  "name": "@vitus-labs/ui-system-root",
  "version": "0.0.0",
  "private": true,
  "description": "vitus-labs",
  "author": "Vit Bokisch <vit@bokisch.cz>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/vitus-labs/ui-system#readme",
  "workspaces": [
    "packages/*",
    "examples/nextjs-*",
    "examples/vite-*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "rewrite-workspace-peers": "node scripts/rewrite-workspace-peers.mjs",
    "logos": "bun scripts/generate-package-logos.mjs",
    "release": "bun run rewrite-workspace-peers && changeset publish",
    "lint": "biome check packages/*/src/",
    "pkgs:clean": "rm -rf node_modules/ bun.lock && bun install",
    "pkgs:build": "bun run --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "size": "size-limit",
    "licenses": "bun scripts/check-licenses.ts",
    "format": "biome format --write .",
    "atlas": "vl_atlas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitus-labs/ui-system.git"
  },
  "bugs": {
    "url": "https://github.com/vitus-labs/ui-system/issues"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitus-labs/tools-atlas": "2.8.0",
    "@vitus-labs/tools-lint": "2.8.0",
    "@vitus-labs/tools-typescript": "2.8.0",
    "@vitus-labs/tools-vitest": "2.8.0",
    "csstype": "^3.2.3",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shell-quote": "^1.12.0",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "nanoid": "^3.3.18",
    "valibot": "^1.4.2",
    "ws": "^8.21.3",
    "react-devtools-core/ws": "^7.5.11",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.3",
    "esbuild": "^0.28.2",
    "baseline-browser-mapping": "^2.11.27",
    "source-map-js": "^1.2.2",
    "storybook": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@storybook/react-dom-shim": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "launch-editor": "^2.14.2",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "dependencies": {
    "@storybook/react": "^10.6.5",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitus-labs/tools-rolldown": "^2.8.0",
    "@vitus-labs/tools-storybook": "^2.8.0",
    "goober": "^2.1.19",
    "next": "^16.4.4",
    "react-is": "^19.3.1",
    "react-native": "^0.88.1",
    "styled-components": "^6.6.0",
    "sugar-high": "^2.6.4",
    "tinybench": "^6.2.3",
    "vite": "^8.3.5"
  }
}

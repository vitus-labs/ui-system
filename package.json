{
  "name": "@vitus-labs/ui-system-root",
  "version": "0.0.0",
  "private": true,
  "description": "vitus-labs",
  "author": "Vit Bokisch <vit@bokisch.cz>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/vitus-labs/ui-system#readme",
  "workspaces": [
    "packages/*",
    "examples/nextjs-*",
    "examples/vite-*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "rewrite-workspace-peers": "node scripts/rewrite-workspace-peers.mjs",
    "logos": "bun scripts/generate-package-logos.mjs",
    "release": "bun run rewrite-workspace-peers && changeset publish",
    "lint": "biome check packages/*/src/",
    "pkgs:clean": "rm -rf node_modules/ bun.lock && bun install",
    "pkgs:build": "bun run --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "size": "size-limit",
    "licenses": "bun scripts/check-licenses.ts",
    "format": "biome format --write .",
    "atlas": "vl_atlas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitus-labs/ui-system.git"
  },
  "bugs": {
    "url": "https://github.com/vitus-labs/ui-system/issues"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/file": "^14.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitus-labs/tools-atlas": "2.7.1",
    "@vitus-labs/tools-lint": "2.7.1",
    "@vitus-labs/tools-typescript": "2.7.1",
    "@vitus-labs/tools-vitest": "2.7.1",
    "csstype": "^3.2.3",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "ts-patch": "^4.0.1",
    "typescript": "6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shell-quote": "^1.10.0",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "nanoid": "^3.3.18",
    "valibot": "^1.4.2",
    "ws": "^8.21.3",
    "react-devtools-core/ws": "^7.5.11"
  },
  "dependencies": {
    "@storybook/react": "^10.6.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitus-labs/tools-rolldown": "^2.7.1",
    "@vitus-labs/tools-storybook": "^2.7.1",
    "goober": "^2.1.19",
    "next": "^16.3.8",
    "react-is": "^19.3.0",
    "react-native": "^0.87.1",
    "styled-components": "^6.5.3",
    "sugar-high": "^2.5.1",
    "tinybench": "^6.2.0",
    "vite": "^8.3.3"
  }
}
